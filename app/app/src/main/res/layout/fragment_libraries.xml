<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:id="@+id/titleLibraries"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_activity_libraries"
            style="@style/title_text" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recLibraries"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/margin_recy" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/textview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_2"
                style="@style/title_text" />
            <TextView
                android:id="@+id/xemThem"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/title_2.1"
                android:textSize="16sp"
                android:textColor="@color/white"
                android:layout_marginTop="24dp"
                android:layout_marginRight="24dp"
                android:gravity="end" />
        </LinearLayout>

        <ListView
            android:id="@+id/listView_libraries"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="24dp" />
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.coordinatorlayout.widget.CoordinatorLayout>