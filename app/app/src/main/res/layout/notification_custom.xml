<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_notification"
    android:padding="8dp"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <!-- Ảnh album -->
    <ImageView
        android:id="@+id/notification_album_art"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:scaleType="centerCrop"
        android:src="@drawable/common_google_signin_btn_icon_dark" />

    <!-- Thông tin bài hát -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/notification_song_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tên bài hát"
            android:textSize="16sp"
            android:textColor="#000000"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/notification_song_artist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ca sĩ"
            android:textSize="14sp"
            android:textColor="#666666"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Các nút điều khiển -->
    <ImageButton
        android:id="@+id/notification_prev"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@android:color/transparent"
        android:src="@drawable/preiou_notication"
        android:contentDescription="Previous" />

    <ImageButton
        android:id="@+id/notification_play_pause"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@android:color/transparent"
        android:src="@drawable/play_arrow"
        android:contentDescription="Play/Pause" />

    <ImageButton
        android:id="@+id/notification_next"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@android:color/transparent"
        android:src="@drawable/next_end_notification"
        android:contentDescription="Next" />

</LinearLayout>
